# Public Firebase Web app configuration: Firebase Console > Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server only. Configure securely in Vercel, never paste the key into chat/Git.
# Full service-account JSON as a single environment-variable value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional local Firebase Emulator Suite (not production):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=1
